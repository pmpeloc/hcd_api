        "fields": [
          {
            "name": "admin",
            "docs": [
              "Program authority; the only signer allowed to verify providers."
            ],
            "type": "pubkey"
          },
          {
            "name": "key_service",
            "docs": [
              "Backend keypair allowed to call `log_access`. Different from the",
              "fee payer on purpose."
            ],
            "type": "pubkey"
          },
          {
            "name": "max_grant_duration_secs",
            "docs": [
              "Maximum lifetime of an AccessGrant, in seconds."
            ],
            "type": "i64"
          },
          {
            "name": "bump",
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "ConfigUpdated",
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "admin",
            "type": "pubkey"
          },
          {
            "name": "key_service",
            "type": "pubkey"
          },
          {
            "name": "max_grant_duration_secs",
            "type": "i64"
          }
        ]
      }
    },
    {
      "name": "GrantStatus",
      "docs": [
        "Revoked grants are kept (not closed) to preserve the audit trail. One PDA",
        "per (record, doctor): granting again re-activates the same account with a",
        "new expiration and keeps `access_count` (team decision, 2026-10-04)."
      ],
      "type": {
        "kind": "enum",
        "variants": [
          {
            "name": "Active"
          },
          {
            "name": "Revoked"
          }
        ]
      }
    },
    {
      "name": "PatientProfile",
      "docs": [
        "Patient profile. Seeds: [\"patient\", authority]"
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "authority",
            "docs": [
              "The patient's embedded wallet (Privy). No DNI is stored anywhere."
            ],
            "type": "pubkey"
          },
          {
            "name": "next_record_id",
            "docs": [
              "Monotonic counter used as seed for each new Record."
            ],
            "type": "u64"
          },
          {
            "name": "created_at",
            "type": "i64"
          },
          {
            "name": "bump",
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "Provider",
      "docs": [
        "A clinic or a doctor registered in the program. Seeds: [\"provider\", authority]"
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "authority",
            "docs": [
              "Wallet that controls this provider account."
            ],
            "type": "pubkey"
          },
          {
            "name": "provider_type",
            "type": {
              "defined": {
                "name": "ProviderType"
              }
            }
          },
          {
            "name": "verified",
            "docs": [
              "Only the admin can set this to true (manual license check off-chain)."
            ],
            "type": "bool"
          },
          {
            "name": "organization",
            "docs": [
              "Organization the provider belongs to. For a clinic: its own pubkey.",
              "For a doctor: the clinic that endorses them (verified off-chain too)."
            ],
            "type": "pubkey"
          },
          {
            "name": "bump",
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "ProviderType",
      "type": {
        "kind": "enum",
        "variants": [
          {
            "name": "Clinic"
          },
          {
            "name": "Doctor"
          }
        ]
      }
    },
    {
      "name": "Record",
      "docs": [
        "A health record issued by a verified doctor.",
        "Seeds: [\"record\", patient, record_id.to_le_bytes()]"
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "patient",
            "docs": [
              "Patient this record belongs to (their authority pubkey)."
            ],
            "type": "pubkey"
          },
          {
            "name": "issuer",
            "docs": [
              "Doctor who issued the record. The issuer can re-read it without a grant."
            ],
            "type": "pubkey"
          },
          {
            "name": "record_id",
            "type": "u64"
          },
          {
            "name": "content_hash",
            "docs": [
              "SHA-256 of the encrypted file. Never medical data itself."
            ],
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          },
          {
            "name": "storage_ref",
            "docs": [
              "Opaque pointer to the ciphertext in off-chain storage (no readable path)."
            ],
            "type": "string"
          },
          {
            "name": "status",
            "type": {
              "defined": {
                "name": "RecordStatus"
              }
            }
          },
          {
            "name": "created_at",
            "type": "i64"
          },
          {
            "name": "rent_payer",
            "docs": [
              "Account that paid the rent; receives it back if the account is closed."
            ],
            "type": "pubkey"
          },
          {
            "name": "supersedes",
            "docs": [
              "When the issuer voids and re-issues a record, points to the voided one."
            ],
            "type": {
              "option": "pubkey"
            }
          },
          {
            "name": "bump",
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "RecordDisputed",
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "record",
            "type": "pubkey"
          },
          {
            "name": "patient",
            "type": "pubkey"
          }
        ]
      }
    },
    {
      "name": "RecordIssued",
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "record",
            "type": "pubkey"
          },
          {
            "name": "patient",
            "type": "pubkey"
          },
          {
            "name": "issuer",
            "type": "pubkey"
          },
          {
            "name": "record_id",
            "type": "u64"
          }
        ]
      }
    },
    {
      "name": "RecordStatus",
      "docs": [
        "Active when issued. The patient can dispute it (\"not mine\"); the issuer can",
        "void a disputed record and re-issue a new one. Nothing edits a record."
      ],
      "type": {
        "kind": "enum",
        "variants": [
          {
            "name": "Active"
          },
          {
            "name": "Disputed"
          },
          {
            "name": "Voided"
          }
        ]
      }
    },
    {
      "name": "RecordVoided",
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "record",
            "type": "pubkey"
          },
          {
            "name": "issuer",
            "type": "pubkey"
          }
        ]
      }
    }
  ]
}