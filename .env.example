# API
PORT=3001
# Comma-separated list of allowed origins for the app and landing.
CORS_ORIGIN=http://localhost:3000

# Supabase (public values; also used by the app)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key: bypasses RLS - storage operations only, minimal usage.
SUPABASE_SERVICE_ROLE=
# Postgres connection string for the app_user role (reads go through RLS).
DATABASE_URL=

# Solana
SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=
SOLANA_RPC_URL_FALLBACK=https://api.devnet.solana.com
PROGRAM_ID=

# Backend keypairs (base58 or JSON byte array). Hot wallet with little SOL.
# FEE_PAYER and KEY_SERVICE must be DIFFERENT keypairs.
FEE_PAYER_SECRET=
KEY_SERVICE_SECRET=

# Master key used to derive each organization's KEK (HKDF). KMS in production.
MASTER_KEY=

# Privy (server-side session/wallet verification)
PRIVY_APP_ID=
PRIVY_APP_SECRET=
